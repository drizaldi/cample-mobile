# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT FLUTTER (CAMPLE)
# Salin file ini menjadi ".env" lalu sesuaikan dengan alamat server kamu.
# ==============================================================================

# 1. Jalur IP Lokal (Gunakan ini jika laptop & HP terhubung ke WiFi yang sama):
# Ganti dengan IP lokal laptop kamu (misal: 192.168.1.xxx atau 10.xx.xx.xx)
API_BASE_URL=http://localhost/backend_cample/public/api

# 2. Jalur Ngrok (Gunakan ini jika testing beda jaringan / testing Midtrans):
# API_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app/backend_cample/public/api
